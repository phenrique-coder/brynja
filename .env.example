# Application URL (auto-detected on Vercel via VERCEL_URL / request origin when unset)
APP_URL=http://localhost:3000

# GitHub OAuth App (required for private & public GitHub repo scanning + user session isolation)
# Local callback:  http://localhost:3000/api/integrations/github/callback
# Vercel callback: https://<your-app>.vercel.app/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/integrations/github/callback
GITHUB_OAUTH_SCOPES=repo read:user read:org

# 64 hex chars (32 bytes) for AES-256-GCM sealing of ephemeral session cookies & stateless ownership certificates
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional NVD API 2.0 Key (improves NVD rate limits dramatically - free at https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Controlled Safe-Probe Guardrails
SAFE_PROBE_MAX_RPS=2
SAFE_PROBE_TIMEOUT_MS=5000
SAFE_PROBE_MAX_REQUESTS_PER_SCAN=40
AUTHORIZATION_TTL_DAYS=7
# Set to false in production / Vercel!
ALLOW_LOCAL_LOOPBACK_TARGETS=false
